{
  "metadata": [
    {
      "src": [
        {
          "src": "{{UNITY_PROJECT}}",
          "files": ["{{ASSEMBLY}}.csproj"],
          "exclude": ["Editor/**", "bin/**"]
        }
      ],
      "globalNamespaceId": "Global",
      "filter": "DocFx/filterConfig.yml",
      "dest": "api",
      "allowCompilationErrors": true,
      "properties": {
        "ProduceReferenceAssembly": "true"
      }
    }
  ],
  "build": {
    "content": [
      { "files": ["**/*.{md,yml}"], "exclude": ["docs/**", "DocFx/**", "tools/**", "tests/**", "README.md", "CLAUDE.md", "AGENTS.md", "context/**"] },
      { "files": ["api/toc.yml"] }
    ],
    "resource": [
      { "files": ["DocFx/images/**"] }
    ],
    "output": "docs",
    "template": ["default", "modern", "DocFx/templates/astra"],
    "disableGitFeatures": true,
    "globalMetadata": {
      "_appName": "{{TITLE}}",
      "_appTitle": "{{TITLE}}",
      "_appLogoPath": "DocFx/images/astra-logo.svg",
      "_enableSearch": true,
      "_enableBreadcrumb": true,
      "_disableContribution": true,
      "_baseUrl": "{{PAGES_URL}}"
    },
    "xref": ["https://normanderwan.github.io/UnityXrefMaps/xrefmap.yml"]
  }
}
